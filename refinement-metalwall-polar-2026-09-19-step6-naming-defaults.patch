From 1d70470d3a5b2b18d7d3d100a54cf836cc6e5ade Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 19 Sep 2026 09:13:54 -0700
Subject: [PATCH 3/7] Default every readout to hidden_sizes=(32, 16)

BulkReadout, LongRangeReadout and GGAReadout used (16, 16) while Local,
LDA, Pairwise and the message layer used (32, 16). Saved models record
their sizes; only freshly built readouts that relied on the default gain a
wider first layer. Recorded in DEPRECATIONS.md with the k_B default change.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CKJKJnMQ5g5crBBPsN5iZn
---
 DEPRECATIONS.md                      | 13 +++++++++++++
 src/equicdft/functional/readout.py   |  4 ++--
 src/equicdft/functional/semilocal.py |  2 +-
 3 files changed, 16 insertions(+), 3 deletions(-)

diff --git a/DEPRECATIONS.md b/DEPRECATIONS.md
index 2f6a41e..82d4692 100644
--- a/DEPRECATIONS.md
+++ b/DEPRECATIONS.md
@@ -46,3 +46,16 @@ aliases of the same tensors and warn when read through `[]` or `.get`.
 | `average_chemical_potential` | `beta_mu_average` |
 | `chemical_potential_weights` | `beta_mu_weights` |
 | `equilibrium_chemical_potential` (solver) | `beta_mu` |
+
+## Changed defaults (0.1.0)
+
+These change freshly built models only; saved models record every
+constructor argument.
+
+- `GridCACEModel(boltzmann_constant=...)` defaults to
+  `equicdft.units.DEFAULT_BOLTZMANN_CONSTANT` (8.617333262e-5 eV/K, the
+  `GridData` default) instead of `1.0`; the model also rejects a batch whose
+  `beta` was built with another constant. Reduced-unit work passes
+  `boltzmann_constant=1.0` to both `GridData` and `GridCACEModel`.
+- `BulkReadout`, `LongRangeReadout` and `GGAReadout` default to
+  `hidden_sizes=(32, 16)` like every other readout, instead of `(16, 16)`.
diff --git a/src/equicdft/functional/readout.py b/src/equicdft/functional/readout.py
index 1a81284..f5e206c 100644
--- a/src/equicdft/functional/readout.py
+++ b/src/equicdft/functional/readout.py
@@ -184,7 +184,7 @@ class BulkReadout(EnergyReadout, Configurable):
     def __init__(
         self,
         n_types: int = 1,
-        hidden_sizes: Sequence[int] = (16, 16),
+        hidden_sizes: Sequence[int] = (32, 16),
         zero_init: bool = True,
     ) -> None:
         super().__init__()
@@ -308,7 +308,7 @@ class LongRangeReadout(EnergyReadout, Configurable):
         self,
         n_kernels: Optional[int] = None,
         n_types: Optional[int] = None,
-        hidden_sizes: Sequence[int] = (16, 16),
+        hidden_sizes: Sequence[int] = (32, 16),
         zero_init: bool = True,
         charges: Optional[Sequence[float]] = None,
         coulomb_amplitude: Optional[float] = None,
diff --git a/src/equicdft/functional/semilocal.py b/src/equicdft/functional/semilocal.py
index eca4bf8..db5c8a0 100644
--- a/src/equicdft/functional/semilocal.py
+++ b/src/equicdft/functional/semilocal.py
@@ -207,7 +207,7 @@ class GGAReadout(EnergyReadout, Configurable):
 
     def __init__(
         self,
-        hidden_sizes: Sequence[int] = (16, 16),
+        hidden_sizes: Sequence[int] = (32, 16),
         n_features: Optional[int] = None,
         n_types: int = 1,
         minimum_coefficient: float = 0.0,
