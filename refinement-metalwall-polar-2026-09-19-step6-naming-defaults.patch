From a31f2a87df56dec937c1f1e1b1b2da6a0e86776a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 19 Sep 2026 09:29:50 -0700
Subject: [PATCH 6/7] Document that forward marks the caller's response fields
 as requiring grad

Ten tests and any analysis code differentiate outputs with respect to the
tensors they passed after a forward pass; replacing the fields by detached
leaves would break that with an obscure autograd error and cannot be
deprecated gradually, so the in-place requires_grad_ stays and is now
documented as part of the contract (step 6h reversed).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CKJKJnMQ5g5crBBPsN5iZn
---
 src/equicdft/model.py | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/equicdft/model.py b/src/equicdft/model.py
index be53b0e..a8f96aa 100644
--- a/src/equicdft/model.py
+++ b/src/equicdft/model.py
@@ -814,6 +814,12 @@ class GridCACEModel(nn.Module, Configurable):
                 )
             if has_polarization and "dipole_density" not in data:
                 raise ValueError("dipole_density is required by this model")
+            # The response fields passed by the caller are marked as requiring
+            # gradients in place. This is part of the contract: after a
+            # forward pass, callers differentiate any output (including
+            # readout observables) with respect to the very tensors they
+            # supplied, e.g. torch.autograd.grad(outputs["c1"].sum(),
+            # data["rho"]). Detached copies would silently break that.
             response_fields = []
             if compute_c1:
                 response_fields.append(data["rho"])
